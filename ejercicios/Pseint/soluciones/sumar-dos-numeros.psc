Algoritmo Sumar2Numeros //Nombre y inicio del archivo 
	
	//Datos
	Definir  Numero1, Numero2 ,Suma Como Entero; //Podemos minimizar lineas de esta forma si todos los datos son del mismo tipo
	
	
	//Entrada
	Escribir  "Ingrese el primer numero"; //Pedimos el primer numero en pantalla
	leer Numero1; //Guardamos el numero en nuestra cajita llamada Numero1
	Escribir  "Ingrese el segundo numero";
	Leer Numero2; //Guardamos el numero en nuestra cajita llamada Numero2
	
	//Proceso 	
	Suma = Numero1 + Numero2; //El proceso de uns suma normal Suma =  N1 + N2 
	
	//Salida
	Escribir "La suma de: ", Numero1, " + ", Numero2, " es ",Suma;
	//La suma de :N1 + N2 es ?
	
	
FinAlgoritmo
