Algoritmo CentimetrosApulgadas
	//Datos
	Definir alturaCentimetros como entero;
	Definir alturaPulgadas como real;
	
	//Entrada
	Escribir  "Ingrese la altura en centimetros "; //Se muestra  en Pantalla  
	Leer alturaCentimetros; //Dato "Entrada" donde se almacena
	
	//Proceso 
	alturaPulgadas = alturaCentimetros * 0.394; //Proceso cm a ft
	
	//Salida
	Escribir "La altura en pulgadas es: ";
	Escribir alturaPulgadas; //  La altura en pulgadas es : ?
	
		
FinAlgoritmo
